{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "composite": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "skipLibCheck": true,
        "strict": true,
        "esModuleInterop": true
    },
    "include": ["**/*"],
    "exclude": ["node_modules", "dist"]
}
